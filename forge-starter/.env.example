# Copy to .env (git-ignored). Everything is optional: with no keys the app runs in offline mode.

# --- Primary LLM: any OpenAI-compatible endpoint. Default = Groq (free tier: https://console.groq.com/keys)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model IDs change -- check the provider's model list if you get 404/400.
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
STT_MODEL=whisper-large-v3-turbo

# --- Fallback LLM (used automatically if primary rate-limits / is down). e.g. OpenRouter, Gemini's OpenAI-compat endpoint
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# --- Memory: leave QDRANT_URL empty for in-process (zero setup). Use Qdrant Cloud free tier for persistence.
QDRANT_URL=
QDRANT_API_KEY=
# EMBEDDINGS: hash (offline) | fastembed (pip install fastembed; better semantic search)
EMBEDDINGS=hash

# --- App
# DOMAIN: module name in backend/app/domain/
DOMAIN=example
CORS_ORIGINS=http://localhost:5173
